{
  "rule": "When an API duration phase is chosen, every bound the base phase states and the API phase does not is reported. Here the API total has a minimum only, so the base maximum of 4 hours is not in the result.",
  "base": [
    {
      "name": "Examplamine",
      "roas": [
        {
          "name": "oral",
          "duration": {
            "total": {
              "min": 1,
              "max": 4,
              "units": "hours"
            }
          }
        }
      ]
    }
  ],
  "api": [
    {
      "name": "Examplamine",
      "roas": [
        {
          "name": "oral",
          "duration": {
            "total": {
              "min": 60,
              "units": "minutes"
            }
          }
        }
      ]
    }
  ],
  "compare": [
    "roas"
  ],
  "reportKinds": [
    "api-block-rejected",
    "base-block-used",
    "block-dropped",
    "dose-boundary-filled",
    "dose-fill-discarded",
    "dose-equal-boundaries",
    "dose-label-differs",
    "unit-repaired",
    "unit-not-mass",
    "duration-rounded",
    "api-phase-ignored",
    "route-only-in-base",
    "route-only-in-api",
    "unit-qualifier-not-adopted",
    "unit-changed",
    "dose-changed",
    "duration-changed",
    "dose-boundary-not-in-api",
    "duration-bound-not-in-api"
  ],
  "expected": [
    {
      "name": "Examplamine",
      "roas": [
        {
          "route": "oral",
          "duration": {
            "total": {
              "min": 60
            }
          }
        }
      ]
    }
  ],
  "report": [
    {
      "kind": "duration-bound-not-in-api",
      "substance": "Examplamine",
      "route": "oral",
      "detail": "duration: total max 240 minutes, not in the API phase"
    }
  ]
}
