    {
      "name": "LSD",
      "interactions": {
        "dangerous": [
          "Tramadol"
        ],
        "unsafe": [
          "Lithium"
        ],
        "uncertain": [
          "Cannabis",
          "MAOI"
        ]
      }
    },
    {
      "name": "Cannabis"
    },
    {
      "name": "Tramadol",
      "interactions": {
        "dangerous": [],
        "unsafe": [],
        "uncertain": [
          "Cannabis"
        ]
      }
    }
  ],
  "api": [
    {
      "name": "Tramadol",
      "dangerousInteractions": [],
      "unsafeInteractions": null,
      "uncertainInteractions": []
    },
    {
      "name": "LSD",
      "dangerousInteractions": [
        {
          "name": "Lithium"
        },
        {
          "name": "MAOIs"
        }
      ],
      "unsafeInteractions": [],
      "uncertainInteractions": [
        {
          "name": "Cannabis"
        }
      ]
    }
  ],
  "compare": [
