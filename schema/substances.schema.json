{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Zadrya/Data/main/schema/substances.schema.json",
  "$comment": "Schema version 1.0.0. The versioning rules are in schema/README.md.",
  "title": "Zadrya substance dataset",
  "description": "The substance catalog built from PsychonautWiki. This schema checks shape only: cross-field invariants (increasing ranges, min not above max, existing references, symmetric interactions, unique names) are checked by the pipeline.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "datasetVersion",
    "attribution",
    "categories",
    "substances"
  ],
  "properties": {
    "schemaVersion": {
      "description": "Semantic version of the schema this document follows. This schema accepts major version 1 only.",
      "type": "string",
      "pattern": "^1\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "datasetVersion": {
      "description": "Semantic version of the dataset content.",
      "$ref": "#/$defs/semver"
    },
    "attribution": {
      "description": "Sources the dataset is derived from, with their licenses. Never empty.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/attribution"
      }
    },
    "categories": {
      "description": "Categories a substance can belong to.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/category"
      }
    },
    "substances": {
      "description": "The substance catalog.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/substance"
      }
    }
  },
  "$defs": {
    "semver": {
      "description": "A semantic version of the form MAJOR.MINOR.PATCH, without pre-release or build metadata.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "text": {
      "description": "A string with at least one character.",
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "description": "A lowercase token: letters and digits, with single hyphens between words.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "attribution": {
      "description": "One source of the dataset.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "url",
        "license"
      ],
      "properties": {
        "name": {
          "description": "Name of the source.",
          "$ref": "#/$defs/text"
        },
        "url": {
          "description": "Address of the source, https only.",
          "type": "string",
          "pattern": "^https://[^\\s]+$"
        },
        "license": {
          "description": "License of the source, as an SPDX identifier where one exists.",
          "$ref": "#/$defs/text"
        }
      }
    },
    "category": {
      "description": "A category of substances.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description"
      ],
      "properties": {
        "id": {
          "description": "Stable identifier that substances refer to.",
          "$ref": "#/$defs/slug"
        },
        "name": {
          "description": "Display name.",
          "$ref": "#/$defs/text"
        },
        "description": {
          "description": "Short explanation of the category.",
          "$ref": "#/$defs/text"
        }
      }
    },
    "substance": {
      "description": "One substance of the catalog.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "aliases",
        "url",
        "categories",
        "classes",
        "roas",
        "crossTolerances",
        "toxicities"
      ],
      "properties": {
        "name": {
          "description": "Canonical name, unique in the catalog. Ingestions store this name.",
          "$ref": "#/$defs/text"
        },
        "aliases": {
          "description": "Other names the substance is known by. May be empty.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "url": {
          "description": "PsychonautWiki article of the substance, https only.",
          "type": "string",
          "pattern": "^https://psychonautwiki\\.org/wiki/[^\\s]+$"
        },
        "summary": {
          "description": "Short description of the substance.",
          "$ref": "#/$defs/text"
        },
        "categories": {
          "description": "Identifiers of the categories the substance belongs to.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/slug"
          }
        },
        "classes": {
          "description": "Classes PsychonautWiki assigns to the substance.",
          "$ref": "#/$defs/classes"
        },
        "roas": {
          "description": "Routes of administration with their dose and duration data.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/roa"
          }
        },
        "tolerance": {
          "description": "How tolerance builds up and fades. Absent when nothing is known.",
          "$ref": "#/$defs/tolerance"
        },
        "crossTolerances": {
          "description": "Classes or groups the substance shares tolerance with, as lowercase tokens.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/slug"
          }
        },
        "addictionPotential": {
          "description": "Free text describing the addiction potential.",
          "$ref": "#/$defs/text"
        },
        "toxicities": {
          "description": "Free text statements about toxicity. May be empty.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "effectsSummary": {
          "description": "Free text overview of the effects.",
          "$ref": "#/$defs/text"
        },
        "dosageRemark": {
          "description": "Free text remark about dosing.",
          "$ref": "#/$defs/text"
        },
        "generalRisks": {
          "description": "Free text about the general risks.",
          "$ref": "#/$defs/text"
        },
        "longtermRisks": {
          "description": "Free text about the long-term risks.",
          "$ref": "#/$defs/text"
        },
        "saferUse": {
          "description": "Safer use advice, one item per piece of advice. Absent when there is none.",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "classes": {
      "description": "Psychoactive and chemical classes of a substance.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "psychoactive",
        "chemical"
      ],
      "properties": {
        "psychoactive": {
          "description": "Psychoactive classes, for example Psychedelics. May be empty.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "chemical": {
          "description": "Chemical classes, for example Lysergamides. May be empty.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "tolerance": {
      "description": "Tolerance timeline in free text. At least one of the three is present.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "full": {
          "description": "When full tolerance is reached.",
          "$ref": "#/$defs/text"
        },
        "half": {
          "description": "Time until tolerance falls to half.",
          "$ref": "#/$defs/text"
        },
        "zero": {
          "description": "Time until tolerance returns to baseline.",
          "$ref": "#/$defs/text"
        }
      }
    },
    "roa": {
      "description": "One route of administration of a substance.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route"
      ],
      "properties": {
        "route": {
          "description": "The route of administration.",
          "enum": [
            "oral",
            "sublingual",
            "buccal",
            "insufflated",
            "rectal",
            "transdermal",
            "subcutaneous",
            "intramuscular",
            "intravenous",
            "smoked",
            "inhaled"
          ]
        },
        "dose": {
          "description": "Dose ranges for this route. Absent when unknown.",
          "$ref": "#/$defs/dose"
        },
        "duration": {
          "description": "Duration of each phase for this route. Absent when unknown.",
          "$ref": "#/$defs/duration"
        },
        "bioavailability": {
          "description": "Bioavailability for this route. Absent when unknown.",
          "$ref": "#/$defs/bioavailability"
        }
      }
    },
    "dose": {
      "description": "Dose classification for one route, in the given units.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "units"
      ],
      "properties": {
        "units": {
          "description": "Units of every number in this object, as PsychonautWiki writes them (for example mg).",
          "$ref": "#/$defs/text"
        },
        "threshold": {
          "description": "Lowest dose with a noticeable effect.",
          "type": "number",
          "minimum": 0
        },
        "light": {
          "description": "Range of a light dose.",
          "$ref": "#/$defs/doseRange"
        },
        "common": {
          "description": "Range of a common dose.",
          "$ref": "#/$defs/doseRange"
        },
        "strong": {
          "description": "Range of a strong dose.",
          "$ref": "#/$defs/doseRange"
        },
        "heavy": {
          "description": "Dose from which the dose is heavy.",
          "type": "number",
          "minimum": 0
        }
      }
    },
    "doseRange": {
      "description": "A closed dose range.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "description": "Lower bound.",
          "type": "number",
          "minimum": 0
        },
        "max": {
          "description": "Upper bound.",
          "type": "number",
          "minimum": 0
        }
      }
    },
    "duration": {
      "description": "Duration of each phase, in minutes. At least one phase is present.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "onset": {
          "description": "Time until the first effects.",
          "$ref": "#/$defs/durationRange"
        },
        "comeup": {
          "description": "Time from the first effects to the peak.",
          "$ref": "#/$defs/durationRange"
        },
        "peak": {
          "description": "Length of the peak.",
          "$ref": "#/$defs/durationRange"
        },
        "offset": {
          "description": "Time the effects take to fade after the peak.",
          "$ref": "#/$defs/durationRange"
        },
        "total": {
          "description": "Total length of the experience.",
          "$ref": "#/$defs/durationRange"
        },
        "afterglow": {
          "description": "Length of the after effects.",
          "$ref": "#/$defs/durationRange"
        }
      }
    },
    "durationRange": {
      "description": "A duration range in minutes. Each bound is optional, at least one is present.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "min": {
          "description": "Lower bound in minutes.",
          "type": "number",
          "minimum": 0
        },
        "max": {
          "description": "Upper bound in minutes.",
          "type": "number",
          "minimum": 0
        }
      }
    },
    "bioavailability": {
      "description": "Bioavailability in percent. Each bound is optional, at least one is present.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "min": {
          "description": "Lower bound in percent.",
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "max": {
          "description": "Upper bound in percent.",
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    }
  }
}
